BASE_URL=https://passport.xiongmaozhanggui.com
HEADLESS=false
EXPLICIT_WAIT=10
PAGE_LOAD_TIMEOUT=30

# 正向登录用例（未配置时自动跳过）
INTERNET_CAFE_ACCOUNT=
INTERNET_CAFE_PASSWORD=

STAFF_CAFE_ACCOUNT=
STAFF_ACCOUNT=
STAFF_PASSWORD=

AGENT_ACCOUNT=
AGENT_PASSWORD=

# 接口 Session 复用（人工登录后从 Network 复制 Cookie 整行）
SESSION_ACCOUNT_B=
SESSION_COOKIE_B=

# 账号 A（切换类用例，可选）
SESSION_ACCOUNT_A=
SESSION_COOKIE_A=

# 业务 API（若与 passport 不同域，改 API_BASE_URL）
API_BASE_URL=https://passport.xiongmaozhanggui.com
API_USER_REFERER=https://passport.xiongmaozhanggui.com/home
API_LIST_REFERER=https://passport.xiongmaozhanggui.com/goods/goods_list
API_REFERER=https://passport.xiongmaozhanggui.com/goods/goods_list
API_CURRENT_USER_PATH=/api/v1/user_info
API_LIST_PATH=/api/c1/get_jifei_conf
API_LOGOUT_PATH=/api/v1/logout
